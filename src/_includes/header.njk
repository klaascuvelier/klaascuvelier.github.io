<header class="site-header mb-5 mx-2">
    <div class="pl-2 py-3 flex flex-row justify-start items-center border-b border-gray-200 dark:border-gray-700">
        <a class="text-l font-medium text-gray-800 visited:text-gray-800 dark:text-[#e9e9e9] mr-2 hover:!text-gray-600 dark:hover:!text-white" href="/">Klaas Cuvelier</a>
        {% if headerSuffix %}
            <span class="mr-2 text-gray-300 dark:text-gray-600">/</span>
            <a class="text-l !text-gray-600 dark:!text-gray-400 hover:!text-gray-800 dark:hover:!text-gray-200 mr-2" href="{{ headerLink }}">{{ headerSuffix }}</a>
        {% endif %}
